<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <targets>
    <!-- 1. 控制台输出目标 (带颜色高亮) -->
    <target name="console" xsi:type="ColoredConsole"
            layout="[${date:format=yyyy-MM-dd HH\:mm\:ss}] [${uppercase:${level}}] [${logger}] [${callsite}]: ${message}"/>

    <!-- 2. 全量行为日志目标 (按年月分包，包含 Debug、Info、Warn、Error、Fatal 等所有日常轨迹) -->
    <target name="file" xsi:type="File"
            fileName="${basedir}/Logs/${date:format=yyyyMM}/${shortdate}.log"
            layout="[${date:format=yyyy-MM-dd HH\:mm\:ss fff}] [${uppercase:${level}}]: ${message}"
            keepFileOpen="false"
            encoding="utf-8" />

    <!-- 3. 独立 Info 日志目标 (只提取 Info 级关键操作，便于追踪高频逻辑) -->
    <target name="info" xsi:type="File"
            fileName="${basedir}/Info/${date:format=yyyyMM}/${shortdate}.log"
            layout="[${date:format=yyyy-MM-dd HH\:mm\:ss fff}] [${uppercase:${level}}]: ${message}"
            keepFileOpen="false"
            encoding="utf-8" />
  </targets>

  <rules>
    <!-- 控制台依旧打印所有 Trace 及以上的日志（便于开发调试） -->
    <logger name="*" minlevel="Trace" writeTo="console"/>

    <!-- 🎯 优化：file 捕获所有 Debug 级别及以上的日志，确保 Warn 和 Fatal 绝不遗漏 -->
    <logger name="*" minlevel="Debug" writeTo="file" />

    <!-- info 保持原样：精准单独提取 Info 级别的日志 -->
    <logger name="*" levels="Info" writeTo="info" />
  </rules>

</nlog>